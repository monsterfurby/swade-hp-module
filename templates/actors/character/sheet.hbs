{{!-- SWADE HP MODULE CUSTOM CHARACTER SHEET --}}
{{!-- This template includes the HP system integrated between Fatigue and Wounds --}}

<form class="{{cssClass}} flexcol" autocomplete="off">
  {{!-- Sheet Header --}}
  <header class="gridcell sheet-header">
    {{!-- Character Image --}}
    <img
      class="profile-img"
      src="{{actor.img}}"
      data-edit="img"
      title="{{actor.name}}"
      alt="{{actor.name}}"
    />

    {{!-- Character Name and Details --}}
    <div class="header-fields">
      <h1 class="charname">
        <input
          name="name"
          type="text"
          value="{{actor.name}}"
          placeholder="{{localize 'SWADE.CharName'}}"
        />
      </h1>

      <div class="resource">
        <label class="resource-label">{{localize 'SWADE.Concept'}}</label>
        <input
          type="text"
          name="system.details.biography.concept"
          value="{{actor.system.details.biography.concept}}"
          data-dtype="String"
        />
      </div>

      <div class="resource">
        <label class="resource-label">{{localize 'SWADE.Race'}}</label>
        <input
          type="text"
          name="system.details.species"
          value="{{actor.system.details.species}}"
          data-dtype="String"
        />
      </div>

      <div class="resource">
        <label class="resource-label">{{localize 'SWADE.Rank'}}</label>
        <select name="system.details.biography.rank" data-dtype="String">
          {{#select actor.system.details.biography.rank}}
            <option value="Novice">{{localize 'SWADE.RankNovice'}}</option>
            <option value="Seasoned">{{localize 'SWADE.RankSeasoned'}}</option>
            <option value="Veteran">{{localize 'SWADE.RankVeteran'}}</option>
            <option value="Heroic">{{localize 'SWADE.RankHeroic'}}</option>
            <option value="Legendary">{{localize 'SWADE.RankLegendary'}}</option>
          {{/select}}
        </select>
      </div>

      <div class="resource">
        <label class="resource-label">{{localize 'SWADE.Advances'}}</label>
        <input
          type="text"
          name="system.advances.value"
          value="{{actor.system.advances.value}}"
          data-dtype="Number"
        />
      </div>
    </div>

    {{!-- Conviction --}}
    {{#if hasConviction}}
      <div class="conviction-wrapper">
        <div class="conviction-counter">
          <span class="conviction-label">{{localize 'SWADE.Conviction'}}</span>
          <span class="conviction-value">{{actor.system.details.conviction.value}}</span>
        </div>
      </div>
    {{/if}}
  </header>

  {{!-- Sheet Navigation --}}
  <nav class="sheet-tabs tabs" data-group="primary">
    <a class="item" data-tab="summary" data-group="primary">{{localize "SWADE.Summary"}}</a>
    <a class="item" data-tab="edges" data-group="primary">{{localize "SWADE.Edges"}}</a>
    <a class="item" data-tab="inventory" data-group="primary">{{localize "SWADE.Inventory"}}</a>
    {{#if (or actor.hasPowers actor.hasArcaneBackground)}}
      <a class="item" data-tab="powers" data-group="primary">{{localize "SWADE.Powers"}}</a>
    {{/if}}
    <a class="item" data-tab="effects" data-group="primary">{{localize "SWADE.Effects"}}</a>
    <a class="item" data-tab="actions" data-group="primary">{{localize "SWADE.Actions"}}</a>
    <a class="item" data-tab="about" data-group="primary">{{localize "SWADE.Biography"}}</a>
  </nav>

  {{!-- Sheet Body --}}
  <main class="gridcell sheet-body">
    {{!-- Summary Tab --}}
    <section class="tab summary active" data-group="primary" data-tab="summary">
      <div style="background: lime; color: black; padding: 10px; font-weight: bold; border: 3px solid red; z-index: 9999;">
        🟢 CUSTOM TEMPLATE WITH HP PARTIAL IS LOADING! 🟢
      </div>
      
      {{!-- Use our custom summary partial that includes HP counter --}}
      {{> "swade-hp-module.character-tab-summary"}}
    </section>

    {{!-- Other Tabs use original SWADE partials --}}
    {{!-- Edges/Hindrances Tab --}}
    <section class="tab edges" data-group="primary" data-tab="edges">
      {{> "swade.character-tab-edges"}}
    </section>
    {{!-- Inventory Tab --}}
    <section class="tab inventory" data-group="primary" data-tab="inventory">
      {{> "swade.character-tab-inventory"}}
    </section>
    {{!-- Powers Tab --}}
    {{#if (or actor.hasPowers actor.hasArcaneBackground)}}
      <section class="tab powers" data-group="primary" data-tab="powers">
        {{> "swade.character-tab-powers"}}
      </section>
    {{/if}}
    {{!-- Effects Tab --}}
    <section class="tab effects" data-group="primary" data-tab="effects">
      {{> "swade.character-tab-effects"}}
    </section>
    {{!-- Actions Tab --}}
    <section class="tab edges" data-group="primary" data-tab="actions">
      {{> "swade.character-tab-actions"}}
    </section>
    {{!-- Biography Tab --}}
    <section class="tab about" data-group="primary" data-tab="about">
      {{> "swade.character-tab-about"}}
    </section>
  </main>

  {{!-- Sheet Footer --}}
  <footer class="sheet-footer flexrow">
    <span class="system-info">{{localize "SWADE.SystemTitle"}} v{{systemVersion}}</span>
  </footer>
</form>